# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay production/test credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_YEARLY_PLAN_ID=
RAZORPAY_AGENCY_MONTHLY_PLAN_ID=
RAZORPAY_AGENCY_YEARLY_PLAN_ID=

# Optional AI provider credentials for real generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional report fallback model when OpenAI is used instead of Anthropic.
OPENAI_REPORT_MODEL=
# Optional: defaults to gpt-image-1. Use an image-generation-capable model available to your OpenAI project.
OPENAI_IMAGE_MODEL=gpt-image-1
ANTHROPIC_API_KEY=
ANTHROPIC_REPORT_MODEL=

# Optional: improves website crawling before analysis.
FIRECRAWL_API_KEY=

# Development/Preview only. Keep false or unset for Production.
TEST_SUBSCRIPTION_MODE=false
